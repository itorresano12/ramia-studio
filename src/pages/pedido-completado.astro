---
import Layout from '../layouts/Layout.astro';

const isDemo = Astro.url.searchParams.get('demo') === 'true';
---

<Layout title="Ramia Studio — Pedido completado" lang="es">
  <main class="min-h-[90vh] flex items-center justify-center px-6 py-20">
    <div class="max-w-lg w-full text-center">

      <!-- Animated checkmark -->
      <div class="w-24 h-24 mx-auto mb-10 relative">
        <div class="absolute inset-0 bg-neutral-900 rounded-full animate-[ping_1s_ease-out_1]"></div>
        <div class="relative w-24 h-24 bg-neutral-900 rounded-full flex items-center justify-center shadow-2xl">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24"
               fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
        </div>
      </div>

      <!-- Heading -->
      <h1 class="font-display text-4xl md:text-5xl font-light text-neutral-900 mb-4 leading-tight">
        ¡Gracias por tu compra!
      </h1>

      <!-- Demo mode notice -->
      {isDemo && (
        <div class="inline-flex items-center gap-2 bg-amber-50 border border-amber-200 text-amber-800 text-xs font-body font-medium tracking-wide px-4 py-2 rounded-full mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          Modo demo — no se ha procesado ningún pago real
        </div>
      )}

      <p class="font-body text-lg text-neutral-400 italic mb-10 font-light">
        Tu pedido ha entrado en el taller de Ramia Studio.
      </p>

      <!-- Workshop card -->
      <div class="bg-[#FAF8F5] border border-neutral-200 rounded-2xl px-8 py-7 mb-10 text-left space-y-4">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-neutral-900 flex-shrink-0 flex items-center justify-center mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                 fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
              <path d="M2 17l10 5 10-5"></path>
              <path d="M2 12l10 5 10-5"></path>
            </svg>
          </div>
          <div>
            <p class="font-body text-sm font-semibold text-neutral-900 tracking-wide uppercase mb-1">
              Artesanía en proceso
            </p>
            <p class="font-body text-sm text-neutral-500 leading-relaxed">
              Cada pieza de Ramia Studio se prepara a mano. Tu pedido pasará por corte láser, montaje de fornitura y control de calidad antes de salir.
            </p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-neutral-100 flex-shrink-0 flex items-center justify-center mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                 fill="none" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
          </div>
          <div>
            <p class="font-body text-sm font-semibold text-neutral-900 tracking-wide uppercase mb-1">
              Envío en 24 / 48 h laborables
            </p>
            <p class="font-body text-sm text-neutral-500 leading-relaxed">
              Recibirás un email con número de seguimiento en cuanto tu pedido salga del taller. Entrega estándar en Península 2–4 días.
            </p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-neutral-100 flex-shrink-0 flex items-center justify-center mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                 fill="none" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <div>
            <p class="font-body text-sm font-semibold text-neutral-900 tracking-wide uppercase mb-1">
              Confirmación por email
            </p>
            <p class="font-body text-sm text-neutral-500 leading-relaxed">
              Stripe te enviará el resumen de compra al instante. Revisa tu carpeta de spam si no lo ves en bandeja.
            </p>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <a href="/"
         class="inline-flex items-center justify-center gap-2 bg-neutral-900 text-white font-body font-medium tracking-[0.18em] uppercase text-xs px-10 py-4 rounded-full hover:bg-neutral-800 transition-colors shadow-lg">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Seguir explorando la colección
      </a>

    </div>
  </main>
</Layout>

<script>
  import { cartItems } from '../stores/cart';
  // Clear cart after successful purchase
  document.addEventListener('astro:page-load', () => {
    cartItems.set([]);
  });
</script>
