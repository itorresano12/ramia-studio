---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/product/ProductCard.astro';
import { MOCK_PRODUCTS } from '../lib/mock-products';
---

<Layout title="Ramia — Joyas de autor en metacrilato">

  <!-- Hero / Header -->
  <header class="w-full pt-16 pb-10 text-center px-4">
    <p class="text-[11px] tracking-[0.25em] uppercase text-neutral-400 mb-4">
      Joyas de autor en metacrilato
    </p>
    <h1 class="text-6xl md:text-8xl font-extralight tracking-tighter text-neutral-900 leading-none mb-5">
      Ramia
    </h1>
    <p class="text-sm text-neutral-400 tracking-[0.15em] uppercase">
      Tu estilo comienza aquí
    </p>
    <!-- Thin divider -->
    <div class="mx-auto mt-10 w-12 h-px bg-neutral-200"></div>
  </header>

  <!-- Catalog grid -->
  <main class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto px-4 py-12">
    {MOCK_PRODUCTS.map((product) => (
      <ProductCard product={product} />
    ))}
  </main>

  <!-- Footer -->
  <footer class="w-full text-center py-10 text-[11px] text-neutral-300 tracking-widest uppercase">
    © {new Date().getFullYear()} Ramia Studio. Todos los derechos reservados.
  </footer>

</Layout>
