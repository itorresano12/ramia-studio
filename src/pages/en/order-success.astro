---
import Layout from '../../layouts/Layout.astro';

const isDemo = Astro.url.searchParams.get('demo') === 'true';
---

<Layout title="Ramia Studio - Order Success" lang="en">
  <main class="min-h-[80vh] flex items-center justify-center px-6">
    <div class="max-w-md w-full text-center">
      <!-- Success Icon -->
      <div class="w-20 h-20 mx-auto bg-neutral-900 rounded-full flex items-center justify-center mb-8 shadow-xl">
        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
      </div>
      
      <h1 class="font-display text-4xl font-light text-neutral-900 mb-4">
        Thank you for your order!
      </h1>

      <!-- Demo mode notice -->
      {isDemo && (
        <div class="inline-flex items-center gap-2 bg-amber-50 border border-amber-200 text-amber-800 text-xs font-body font-medium tracking-wide px-4 py-2 rounded-full mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          Demo mode — no real payment was processed
        </div>
      )}

      <p class="font-body text-neutral-500 mb-8 leading-relaxed">
        Your Ramia Studio piece is on its way.<br/>
        We are preparing your order in our atelier with artisanal care. You will receive a tracking number via email within 24/48h.
      </p>
      
      <a href="/en" class="inline-flex items-center justify-center bg-neutral-100 text-neutral-900 font-body font-medium tracking-[0.18em] uppercase text-xs px-8 py-4 rounded-full hover:bg-neutral-200 transition-colors">
        Back to collection
      </a>
    </div>
  </main>
</Layout>

<script>
  import { cartItems } from '../../stores/cart';
  // Empty cart after successful payment
  cartItems.set([]);
</script>
