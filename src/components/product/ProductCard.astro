---
import type { Product } from '../../types/product';
import { es } from '../../i18n/es';
import { en } from '../../i18n/en';
import { Image } from 'astro:assets';

interface Props {
  product: Product;
  lang: 'es' | 'en';
}

const { product, lang } = Astro.props;
const t = lang === 'es' ? es : en;

// Iridescent CSS fallback gradient per product
const gradients: Record<string, string> = {
  'prod-001': 'linear-gradient(135deg, #ede8f5 0%, #f5ede8 40%, #e8f5f2 100%)',
  'prod-002': 'linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%)',
  'prod-003': 'linear-gradient(135deg, #fff4ee 0%, #f7efff 40%, #eaf6fb 100%)',
  'prod-004': 'linear-gradient(135deg, #f5ede0 0%, #e8ddd0 50%, #f0e8e0 100%)',
  'prod-005': 'linear-gradient(135deg, #f0f0f0 0%, #e8e8e8 40%, #f5f5f5 100%)',
  'prod-006': 'linear-gradient(135deg, #111111 0%, #282828 50%, #1a1a1a 100%)',
};
const fallbackBg = gradients[product.id] ?? 'linear-gradient(135deg, #f0ede8 0%, #e8edf0 100%)';
const hasClip = product.closureOptions.includes('clip');
---

<article
  class="product-card group relative h-full w-full max-w-full min-w-0 flex flex-col bg-white rounded-2xl overflow-hidden border border-neutral-100 p-4 transition-all duration-300"
  data-category={product.category}
  data-clip={hasClip ? 'true' : 'false'}
>
  <!-- ── Media ── -->
  <a href={lang === 'es' ? `/producto/${product.slug}` : `/en/product/${product.slug}`}
     class="relative w-full aspect-square overflow-hidden rounded-xl bg-neutral-100 mb-4 block" style={`background:${fallbackBg};`}>

    <!-- Static image -->
    <img
      src={`${product.imageStatic}&w=800`}
      srcset={`${product.imageStatic}&w=400 400w, ${product.imageStatic}&w=800 800w`}
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
      alt={product.imageAlt || product.title[lang]}
      class="w-full h-full object-cover object-center block absolute inset-0
             transition-all duration-700 ease-out
             group-hover:scale-105 group-hover:opacity-0"
      loading="lazy"
      decoding="async"
    />

    <!-- Hover video -->
    <video
      src={product.videoHover}
      autoplay loop muted playsinline
      class="absolute inset-0 w-full h-full object-cover
             opacity-0 transition-opacity duration-500 ease-out group-hover:opacity-100"
      aria-hidden="true"
    ></video>

    <!-- Bottom fade -->
    <div class="absolute inset-x-0 bottom-0 h-24 pointer-events-none"
         style="background:linear-gradient(to top,rgba(250,249,246,0.9) 0%,transparent 100%)"
         aria-hidden="true"></div>

    <!-- Weight badge -->
    <div class="absolute top-4 left-4 z-10 flex flex-col gap-1.5 pointer-events-none">
      <span class="inline-flex items-center gap-1.5 backdrop-blur-md bg-white/90
                   border border-neutral-200/50 text-neutral-800
                   text-[10px] font-body font-medium tracking-[0.12em] uppercase
                   px-3 py-1.5 rounded-full shadow-sm select-none">
        {product.weightGrams}g&ensp;·&ensp;{lang === 'es' ? 'Ultraligero' : 'Ultralight'}
      </span>
      {hasClip && (
        <span class="inline-flex items-center gap-1 backdrop-blur-md bg-white/90
                     border border-neutral-200/50 text-neutral-800
                     text-[9px] font-body font-medium tracking-[0.12em] uppercase
                     px-2.5 py-1 rounded-full shadow-sm select-none">
          ✦ {t.filters.clip.split('(')[0].trim()}
        </span>
      )}
    </div>

    <!-- Out-of-stock -->
    {!product.inStock && (
      <div class="absolute inset-0 bg-white/60 backdrop-blur-sm
                  flex items-center justify-center z-20 pointer-events-none">
        <span class="text-xs tracking-widest uppercase text-neutral-600 font-body font-medium">
          {lang === 'es' ? 'Agotado' : 'Sold Out'}
        </span>
      </div>
    )}
  </a>

  <!-- ✧ Info ✧ -->
  <div class="flex-grow flex flex-col gap-1 pt-4 px-2 pb-2">
    <!-- Closure type / Finish -->
    <p class="text-[10px] tracking-[0.18em] uppercase text-neutral-600 font-body font-medium mb-0.5">
      {product.closureType[lang]}
    </p>

    <!-- Title -->
    <a href={lang === 'es' ? `/producto/${product.slug}` : `/en/product/${product.slug}`} class="group-hover:text-neutral-500 transition-colors duration-300">
      <h2 class="font-display text-xl font-light text-neutral-900 group-hover:text-neutral-500 transition-colors duration-300 leading-snug tracking-tight">
        {product.title[lang]}
      </h2>
    </a>

    <!-- Dimensions -->
    <p class="text-[11px] text-neutral-600 font-body mt-0.5">
      {product.dimensions}
    </p>

    <!-- Price + CTA -->
    <div class="mt-auto pt-3 flex items-center justify-between gap-2 w-full min-w-0 flex-wrap">
      <span class="text-base sm:text-lg font-serif text-neutral-900 shrink-0">
        {product.price.toFixed(2)}<span class="text-sm ml-0.5">€</span>
      </span>
      <button
        class="add-to-cart-btn shrink-0 px-3.5 py-2.5 sm:px-4 sm:py-3 bg-neutral-900 hover:bg-neutral-800 text-white text-[11px] sm:text-xs font-semibold tracking-wider uppercase rounded-full transition-colors whitespace-nowrap shadow-sm hover:shadow-md active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed"
        aria-label={`${t.product.addToBag} - ${product.title[lang]}`}
        disabled={!product.inStock}
        data-product={JSON.stringify(product)}
      >
        {product.inStock ? t.product.addToBag : (lang === 'es' ? 'Agotado' : 'Sold Out')}
      </button>
    </div>
  </div>
</article>

<script>
  import { addItem } from '../../stores/cart';
  import type { Product } from '../../types/product';

  document.addEventListener('astro:page-load', () => {
    const buttons = document.querySelectorAll('.add-to-cart-btn');
    buttons.forEach(btn => {
      // Clone and replace to avoid duplicate listeners if page-load fires multiple times
      const newBtn = btn.cloneNode(true);
      btn.parentNode?.replaceChild(newBtn, btn);
      
      newBtn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        if (target.dataset.product) {
          const product: Product = JSON.parse(target.dataset.product);
          addItem(product, 'acero');
        }
      });
    });
  });
</script>

<style>
  @media (hover: none) {
    video { display: none; }
    img   { opacity: 1 !important; transform: none !important; }
  }
</style>
