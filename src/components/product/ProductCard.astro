---
import type { Product } from '../../types/product';

interface Props {
  product: Product;
}

const { product } = Astro.props;

// Iridescent fallback gradient (changes per product via id hash)
const gradients: Record<string, string> = {
  'prod-001': 'linear-gradient(135deg, #e8e0f0 0%, #f0e8e0 40%, #e0f0ee 100%)',
  'prod-002': 'linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%)',
  'prod-003': 'linear-gradient(135deg, #fff1eb 0%, #f9f0ff 40%, #e8f4f8 100%)',
};
const fallbackBg = gradients[product.id] ?? 'linear-gradient(135deg, #f0ede8 0%, #e8edf0 100%)';
---

<article class="group relative flex flex-col bg-white/60 border border-neutral-200/50 rounded-3xl overflow-hidden
                shadow-[0_2px_20px_0_rgba(0,0,0,0.05)] hover:shadow-[0_8px_40px_0_rgba(0,0,0,0.10)]
                transition-shadow duration-500 ease-out backdrop-blur-sm">

  <!-- ── Media block ── -->
  <div
    class="relative w-full overflow-hidden"
    style={`aspect-ratio: 4/5; background: ${fallbackBg};`}
  >
    <!-- Static image with zoom -->
    <img
      src={product.imageStatic}
      alt={product.title.es}
      class="absolute inset-0 w-full h-full object-cover
             transition-all duration-700 ease-out
             group-hover:scale-105 group-hover:opacity-0"
      loading="lazy"
    />

    <!-- Hover video -->
    <video
      src={product.videoHover}
      autoplay
      loop
      muted
      playsinline
      class="absolute inset-0 w-full h-full object-cover opacity-0
             transition-opacity duration-500 ease-out group-hover:opacity-100"
      aria-hidden="true"
    ></video>

    <!-- Iridescent overlay at bottom -->
    <div class="absolute inset-x-0 bottom-0 h-28 pointer-events-none"
         style="background: linear-gradient(to top, rgba(250,249,246,0.85) 0%, transparent 100%);"></div>

    <!-- Weight badge -->
    <div class="absolute top-4 left-4 z-10">
      <span class="inline-flex items-center gap-1.5
                   backdrop-blur-md bg-white/80 border border-white/90
                   text-neutral-700 text-[10px] font-medium tracking-[0.12em] uppercase
                   px-3 py-1.5 rounded-full select-none shadow-sm">
        {product.weightGrams}g&ensp;·&ensp;Ultraligero
      </span>
    </div>

    <!-- Out-of-stock -->
    {!product.inStock && (
      <div class="absolute inset-0 bg-white/60 backdrop-blur-sm flex items-center justify-center z-20">
        <span class="text-xs tracking-widest uppercase text-neutral-400 font-medium font-body">Agotado</span>
      </div>
    )}
  </div>

  <!-- ── Info block ── -->
  <div class="flex flex-col gap-1 px-5 pt-5 pb-6">

    <!-- Closure type -->
    <p class="text-[10px] tracking-[0.18em] uppercase text-neutral-400 font-body font-medium mb-1">
      {product.closureType.es}
    </p>

    <!-- Title -->
    <h2 class="font-display text-xl font-light text-neutral-900 leading-snug tracking-tight">
      {product.title.es}
    </h2>

    <!-- Dimensions -->
    <p class="text-[11px] text-neutral-400 font-body mt-0.5">
      {product.dimensions}
    </p>

    <!-- Price + CTA -->
    <div class="flex items-center justify-between mt-4 gap-3">
      <span class="font-display text-2xl font-light text-neutral-900 tracking-tight">
        {product.price.toFixed(2)}<span class="text-base ml-0.5">€</span>
      </span>

      <button
        class="flex-shrink-0 text-[10px] font-body font-medium tracking-[0.18em] uppercase
               bg-neutral-900 text-white hover:bg-neutral-700
               active:scale-95
               px-5 py-2.5 rounded-full
               transition-all duration-200 ease-out
               shadow-sm hover:shadow-md"
        aria-label={`Añadir ${product.title.es} a la bolsa`}
      >
        Añadir a la Bolsa
      </button>
    </div>
  </div>
</article>

<style>
  /* Disable video on touch devices */
  @media (hover: none) {
    video { display: none; }
    img   { opacity: 1 !important; transform: none !important; }
  }
</style>
