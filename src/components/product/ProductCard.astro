---
import type { Product } from '../../types/product';
import { es } from '../../i18n/es';
import { en } from '../../i18n/en';

interface Props {
  product: Product;
  lang: 'es' | 'en';
}

const { product, lang } = Astro.props;
const t = lang === 'es' ? es : en;

// Iridescent CSS fallback gradient per product
const gradients: Record<string, string> = {
  'prod-001': 'linear-gradient(135deg, #ede8f5 0%, #f5ede8 40%, #e8f5f2 100%)',
  'prod-002': 'linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%)',
  'prod-003': 'linear-gradient(135deg, #fff4ee 0%, #f7efff 40%, #eaf6fb 100%)',
  'prod-004': 'linear-gradient(135deg, #f5ede0 0%, #e8ddd0 50%, #f0e8e0 100%)',
  'prod-005': 'linear-gradient(135deg, #f0f0f0 0%, #e8e8e8 40%, #f5f5f5 100%)',
  'prod-006': 'linear-gradient(135deg, #111111 0%, #282828 50%, #1a1a1a 100%)',
};
const fallbackBg = gradients[product.id] ?? 'linear-gradient(135deg, #f0ede8 0%, #e8edf0 100%)';
const hasClip = product.closureOptions.includes('clip');
---

<article
  class="product-card group relative flex flex-col bg-white/60 border border-neutral-200/50
         rounded-3xl overflow-hidden
         shadow-[0_2px_20px_0_rgba(0,0,0,0.05)]
         hover:shadow-[0_8px_40px_0_rgba(0,0,0,0.10)]
         transition-shadow duration-500 ease-out backdrop-blur-sm"
  data-category={product.category}
  data-clip={hasClip ? 'true' : 'false'}
>
  <!-- ── Media ── -->
  <a href={lang === 'es' ? `/producto/${product.slug}` : `/en/product/${product.slug}`}
     class="relative w-full overflow-hidden block" style={`aspect-ratio:4/5; background:${fallbackBg};`}>

    <!-- Static image -->
    <img
      src={product.imageStatic}
      alt={product.title[lang]}
      class="absolute inset-0 w-full h-full object-cover
             transition-all duration-700 ease-out
             group-hover:scale-105 group-hover:opacity-0"
      loading="lazy"
    />

    <!-- Hover video -->
    <video
      src={product.videoHover}
      autoplay loop muted playsinline
      class="absolute inset-0 w-full h-full object-cover
             opacity-0 transition-opacity duration-500 ease-out group-hover:opacity-100"
      aria-hidden="true"
    ></video>

    <!-- Bottom fade -->
    <div class="absolute inset-x-0 bottom-0 h-24 pointer-events-none"
         style="background:linear-gradient(to top,rgba(250,249,246,0.9) 0%,transparent 100%)"
         aria-hidden="true"></div>

    <!-- Weight badge -->
    <div class="absolute top-4 left-4 z-10 flex flex-col gap-1.5 pointer-events-none">
      <span class="inline-flex items-center gap-1.5 backdrop-blur-md bg-white/80
                   border border-white/90 text-neutral-700
                   text-[10px] font-body font-medium tracking-[0.12em] uppercase
                   px-3 py-1.5 rounded-full shadow-sm select-none">
        {product.weightGrams}g&ensp;·&ensp;{t.guarantees.ultralight.split(' ')[0]}
      </span>
      {hasClip && (
        <span class="inline-flex items-center gap-1 backdrop-blur-md bg-neutral-900/85
                     text-white text-[9px] font-body font-medium tracking-[0.12em] uppercase
                     px-2.5 py-1 rounded-full shadow-sm select-none">
          ✦ {t.filters.clip.split('(')[0].trim()}
        </span>
      )}
    </div>

    <!-- Out-of-stock -->
    {!product.inStock && (
      <div class="absolute inset-0 bg-white/60 backdrop-blur-sm
                  flex items-center justify-center z-20 pointer-events-none">
        <span class="text-xs tracking-widest uppercase text-neutral-400 font-body font-medium">
          {lang === 'es' ? 'Agotado' : 'Sold Out'}
        </span>
      </div>
    )}
  </a>

  <!-- ── Info ── -->
  <div class="flex flex-col gap-1 px-5 pt-5 pb-6">
    <!-- Closure type -->
    <p class="text-[10px] tracking-[0.18em] uppercase text-neutral-400 font-body font-medium mb-0.5">
      {product.closureType[lang]}
    </p>

    <!-- Title -->
    <a href={lang === 'es' ? `/producto/${product.slug}` : `/en/product/${product.slug}`} class="group-hover:text-neutral-500 transition-colors duration-300">
      <h2 class="font-display text-xl font-light text-neutral-900 group-hover:text-neutral-500 transition-colors duration-300 leading-snug tracking-tight">
        {product.title[lang]}
      </h2>
    </a>

    <!-- Dimensions -->
    <p class="text-[11px] text-neutral-400 font-body mt-0.5">
      {product.dimensions}
    </p>

    <!-- Price + CTA -->
    <div class="flex items-center justify-between mt-4 gap-3">
      <span class="font-display text-2xl font-light text-neutral-900 tracking-tight">
        {product.price.toFixed(2)}<span class="text-base ml-0.5">€</span>
      </span>
      <button
        class="add-to-cart-btn flex-shrink-0 text-[10px] font-body font-medium tracking-[0.18em] uppercase
               bg-neutral-900 text-white hover:bg-neutral-700 active:scale-95
               px-5 py-2.5 rounded-full transition-all duration-200 ease-out
               shadow-sm hover:shadow-md disabled:opacity-40 disabled:cursor-not-allowed"
        aria-label={`${t.product.addToBag} - ${product.title[lang]}`}
        disabled={!product.inStock}
        data-product={JSON.stringify(product)}
      >
        {product.inStock ? t.product.addToBag : (lang === 'es' ? 'Agotado' : 'Sold Out')}
      </button>
    </div>
  </div>
</article>

<script>
  import { addItem } from '../../stores/cart';
  import type { Product } from '../../types/product';

  const buttons = document.querySelectorAll('.add-to-cart-btn');
  buttons.forEach(btn => {
    // avoid attaching multiple times if hydrated multiple times, but astro script runs once
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      if (target.dataset.product) {
        const product: Product = JSON.parse(target.dataset.product);
        addItem(product, 'acero');
      }
    });
  });
</script>

<style>
  @media (hover: none) {
    video { display: none; }
    img   { opacity: 1 !important; transform: none !important; }
  }
</style>
