---
import { getProducts } from '../../lib/sanity';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const isEs = lang === 'es';
const enableStripe = import.meta.env.PUBLIC_ENABLE_STRIPE === 'true';

const allProducts = await getProducts();
const crossSellProducts = allProducts.slice(0, 3).map(p => ({
  id: p.id,
  title: p.title,
  price: p.price,
  imageStatic: p.imageStatic,
  slug: p.slug,
  weightGrams: p.weightGrams
}));
---

<!-- Overlay -->
<div id="cart-overlay" 
     class="fixed inset-0 bg-black/50 z-50 opacity-0 pointer-events-none transition-opacity duration-300 ease-out"
     aria-hidden="true"></div>

<!-- Drawer -->
<aside id="cart-drawer"
       class="fixed inset-y-0 right-0 z-50 w-full sm:max-w-md bg-white flex flex-col h-[100dvh] max-h-[100dvh] overflow-hidden shadow-2xl transition-transform duration-300 translate-x-full invisible pointer-events-none"
       aria-label={isEs ? "Tu Bolsa" : "Your Bag"}>
       
  <!-- Header -->
  <header class="shrink-0 px-6 py-4 border-b border-neutral-100 flex items-center justify-between">
    <h2 class="font-display text-2xl font-light text-neutral-900">
      {isEs ? "Tu Bolsa" : "Your Bag"}
      <span id="cart-header-count" class="text-neutral-600 text-lg ml-1">(0)</span>
    </h2>
    <button id="close-cart-btn"
            class="text-neutral-600 hover:text-neutral-900 transition-colors p-2 -mr-2"
            aria-label={isEs ? "Cerrar bolsa" : "Close bag"}>
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6 6 18M6 6l12 12"/>
      </svg>
    </button>
  </header>

  <!-- Progress Bar -->
  <div class="shrink-0 px-6 py-3 bg-neutral-50">
    <p id="shipping-msg" class="font-body text-[11px] uppercase tracking-widest text-neutral-900 text-center mb-3">
      <!-- Injected via JS -->
    </p>
    <div class="h-0.5 w-full bg-neutral-200 rounded-full overflow-hidden">
      <div id="shipping-progress" class="h-full bg-neutral-900 transition-all duration-500 ease-out" style="width: 0%"></div>
    </div>
  </div>

  <!-- Items list -->
  <div class="flex-1 min-h-0 overflow-y-auto overscroll-contain p-4 sm:p-6 space-y-4" id="cart-items-container">
    <!-- Populated via JS -->
  </div>

  <!-- Empty state -->
  <div id="cart-empty-state" class="hidden flex-1 flex-col items-center justify-center p-8 text-center min-h-[30vh]">
    <div class="w-16 h-16 bg-neutral-100 rounded-full flex items-center justify-center mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24" class="text-neutral-400">
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" stroke-linecap="round" stroke-linejoin="round"/>
        <line x1="3" y1="6" x2="21" y2="6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <p class="font-display italic text-lg text-neutral-600 mb-8">{isEs ? "Tu bolsa está vacía.." : "Your bag is empty."}</p>
    <button id="continue-shopping-btn" class="text-xs font-body tracking-[0.2em] uppercase border border-neutral-900 px-8 py-3 hover:bg-neutral-900 hover:text-white transition-colors duration-300">
      {isEs ? "Descubrir Colección" : "Discover Collection"}
    </button>
  </div>

  <!-- Footer -->
  <footer id="cart-footer" class="shrink-0 mt-auto bg-white border-t border-neutral-100 p-4 sm:p-6 pb-[calc(1rem+env(safe-area-inset-bottom))]">
    <div class="flex items-center justify-between mb-4">
      <span class="font-body text-sm text-neutral-500 uppercase tracking-widest">{isEs ? "Subtotal" : "Subtotal"}</span>
      <span class="font-display text-2xl font-light text-neutral-900" id="cart-subtotal">0.00€</span>
    </div>
    <p class="text-[10px] text-neutral-600 font-body mb-6">
      <span id="cart-footer-shipping-text">{isEs ? "IVA incluido. Envío estándar calculado en el checkout." : "VAT included. Shipping calculated at checkout."}</span>
      <br/>
      <span class="text-neutral-500 italic font-display text-sm block mt-1">
        {isEs ? "Diseñados para no pesar." : "Designed to be weightless."}
      </span>
    </p>

    <button id="checkout-btn"
            class="w-full py-3.5 bg-neutral-900 hover:bg-neutral-800 text-white text-xs font-semibold tracking-widest uppercase block text-center transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
      <span class="checkout-text">{isEs ? "Encargar vía WhatsApp" : "Order via WhatsApp"}</span>
      <span class="checkout-loader hidden items-center justify-center gap-2">
        <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        {isEs ? "Procesando..." : "Processing..."}
      </span>
    </button>
  </footer>
</aside>

<script>
  import { isCartOpen, cartItems, cartTotal, cartCount, freeShippingProgress, closeCart, updateQuantity, removeItem, freeShippingThreshold } from '../../stores/cart';

  let unsubs: Array<() => void> = [];

  document.addEventListener('astro:page-load', () => {
    const lang = document.documentElement.lang;
    const isEs = lang === 'es';

    const formatPrice = (amount: number) => new Intl.NumberFormat(isEs ? 'es-ES' : 'en-IE', { style: 'currency', currency: 'EUR' }).format(amount);

    unsubs.forEach(unsub => unsub());
    unsubs = [];

    const overlay = document.getElementById('cart-overlay');
    const drawer = document.getElementById('cart-drawer');
    const closeBtn = document.getElementById('close-cart-btn');
    const continueBtn = document.getElementById('continue-shopping-btn');
    
    const headerCount = document.getElementById('cart-header-count');
    const subtotalEl = document.getElementById('cart-subtotal');
    const itemsContainer = document.getElementById('cart-items-container');
    const emptyState = document.getElementById('cart-empty-state');
    const footer = document.getElementById('cart-footer');
    
    const shippingMsg = document.getElementById('shipping-msg');
    const footerShippingText = document.getElementById('cart-footer-shipping-text');
    const shippingProgress = document.getElementById('shipping-progress');

    unsubs.push(isCartOpen.subscribe(open => {
      if (open) {
        document.body.style.overflow = 'hidden';
        document.body.style.touchAction = 'none';
        overlay?.classList.remove('hidden');
        drawer?.classList.remove('invisible', 'pointer-events-none');
        drawer?.classList.add('visible', 'pointer-events-auto');
        setTimeout(() => {
          overlay?.classList.remove('opacity-0');
          drawer?.classList.remove('translate-x-full');
          drawer?.classList.add('translate-x-0');
        }, 10);
      } else {
        document.body.style.overflow = '';
        document.body.style.touchAction = '';
        overlay?.classList.add('opacity-0');
        drawer?.classList.remove('translate-x-0');
        drawer?.classList.add('translate-x-full');
        setTimeout(() => {
          overlay?.classList.add('hidden');
          drawer?.classList.remove('visible', 'pointer-events-auto');
          drawer?.classList.add('invisible', 'pointer-events-none');
        }, 300);
      }
    }));

    overlay?.addEventListener('click', closeCart);
    closeBtn?.addEventListener('click', closeCart);
    continueBtn?.addEventListener('click', () => {
      closeCart();
      window.location.href = isEs ? '/#coleccion' : '/en#coleccion';
    });

    unsubs.push(cartCount.subscribe(count => {
      if (headerCount) headerCount.textContent = `(${count})`;
      if (count === 0) {
        itemsContainer?.classList.add('hidden');
        footer?.classList.add('hidden');
        emptyState?.classList.remove('hidden');
      } else {
        itemsContainer?.classList.remove('hidden');
        footer?.classList.remove('hidden');
        emptyState?.classList.add('hidden');
      }
    }));

    unsubs.push(cartTotal.subscribe(total => {
      if (subtotalEl) subtotalEl.textContent = formatPrice(total);
      
      if (shippingMsg && shippingProgress) {
        const remaining = freeShippingThreshold - total;
        
        if (remaining > 0) {
          shippingMsg.textContent = isEs 
            ? `FALTAN ${formatPrice(remaining)} PARA ENVÍO GRATUITO` 
            : `ADD ${formatPrice(remaining)} FOR FREE SHIPPING`;
          if (footerShippingText) {
            footerShippingText.textContent = isEs 
              ? "IVA incluido. Envío estándar calculado en el checkout." 
              : "VAT included. Shipping calculated at checkout.";
          }
        } else {
          shippingMsg.textContent = isEs 
            ? `¡TIENES ENVÍO GRATUITO ASEGURADO!` 
            : `YOU HAVE SECURED FREE SHIPPING!`;
          if (footerShippingText) {
            footerShippingText.textContent = isEs 
              ? "IVA incluido. Envío estándar gratuito aplicado." 
              : "VAT included. Free standard shipping applied.";
          }
        }
      }
    }));

    unsubs.push(freeShippingProgress.subscribe(progress => {
      if (shippingProgress) shippingProgress.style.width = `${progress}%`;
    }));

    // Render Cart Items
    unsubs.push(cartItems.subscribe(items => {
      if (!itemsContainer) return;
      
      itemsContainer.innerHTML = '';
      
      items.forEach(item => {
        const title = isEs ? item.titleEs : item.titleEn;
        const closureLabel = item.closureSelected === 'clip' 
          ? (isEs ? 'Opción Clip' : 'Clip Option')
          : (isEs ? 'Acero Inoxidable' : 'Stainless Steel');

        const itemEl = document.createElement('div');
        itemEl.className = 'flex gap-4 py-4 border-b border-neutral-100 last:border-0';
        
        itemEl.innerHTML = `
          <div class="w-20 h-24 shrink-0 bg-neutral-100 rounded-lg overflow-hidden shadow-sm">
            <img src="${item.image}" alt="${title}" class="w-full h-full object-cover" />
          </div>
          <div class="flex flex-col flex-1 justify-between py-0.5">
            <div>
              <div class="flex justify-between items-start gap-2">
                <h3 class="font-display text-lg text-neutral-900 leading-tight">${title}</h3>
                <button class="remove-item-btn text-neutral-600 hover:text-neutral-900 p-1 -mr-1 transition-colors" data-id="${item.id}" aria-label="Remove item">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 6 6 18M6 6l12 12"/>
                  </svg>
                </button>
              </div>
              <p class="text-[10px] font-body text-neutral-600 uppercase tracking-widest mt-1">${closureLabel}</p>
            </div>
            
            <div class="flex justify-between items-end">
              <div class="flex items-center gap-3 border border-neutral-200 rounded-full px-3 py-1 bg-white">
                <button class="qty-btn text-neutral-600 hover:text-neutral-900 transition-colors" data-id="${item.id}" data-action="minus" aria-label="Decrease quantity">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/></svg>
                </button>
                <span class="font-body text-xs font-medium text-neutral-900 min-w-[12px] text-center">${item.quantity}</span>
                <button class="qty-btn text-neutral-600 hover:text-neutral-900 transition-colors" data-id="${item.id}" data-action="plus" aria-label="Increase quantity">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                </button>
              </div>
              <span class="font-display text-lg text-neutral-900">${formatPrice(item.price * item.quantity)}</span>
            </div>
          </div>
        `;
        itemsContainer.appendChild(itemEl);
      });

      // Attach event listeners
      itemsContainer.querySelectorAll('.remove-item-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).dataset.id;
          if (id) removeItem(id);
        });
      });

      itemsContainer.querySelectorAll('.qty-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const id = target.dataset.id;
          const action = target.dataset.action;
          if (!id || !action) return;
          
          const item = items.find(i => i.id === id);
          if (item) {
            updateQuantity(id, action === 'plus' ? item.quantity + 1 : item.quantity - 1);
          }
        });
      });

      // Cross-Selling Logic
      const crossSellContainer = document.getElementById('cross-sell-container');
      const crossSellItems = document.querySelectorAll('.cross-sell-item');
      
      let visibleCount = 0;
      const itemIdsInCart = items.map(i => i.productId);
      
      crossSellItems.forEach(el => {
        const pid = (el as HTMLElement).dataset.productId;
        if (pid && !itemIdsInCart.includes(pid) && visibleCount < 2) {
            el.classList.remove('hidden');
            visibleCount++;
        } else {
            el.classList.add('hidden');
        }
      });
      
      if (visibleCount > 0 && items.length > 0) {
          crossSellContainer?.classList.remove('hidden');
      } else {
          crossSellContainer?.classList.add('hidden');
      }
    }));

    // Attach listeners for Cross-Sell Add Buttons
    document.querySelectorAll('.add-cross-sell-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const productData = target.dataset.product;
        if (productData) {
          import('../../stores/cart').then(({ addItem }) => {
            const p = JSON.parse(productData);
            // Mock missing fields for addItem
            const fullProduct = { ...p, title: p.title }; 
            addItem(fullProduct, 'acero');
          });
        }
      });
    });

    // WhatsApp Checkout Integration (Concierge)
    const checkoutBtn = document.getElementById('checkout-btn') as HTMLButtonElement;
    const checkoutText = document.getElementById('checkout-text');
    const checkoutLoader = document.getElementById('checkout-loader');

    checkoutBtn?.addEventListener('click', async () => {
      const items = cartItems.get();
      if (items.length === 0) return;

      checkoutBtn.disabled = true;
      checkoutText?.classList.add('hidden');
      checkoutLoader?.classList.remove('hidden');
      checkoutLoader?.classList.add('flex');

      // WhatsApp Checkout logic
      const total = items.reduce((sum, i) => sum + i.price * i.quantity, 0);
      let orderList = items.map(i => `- ${i.quantity}x ${isEs ? i.titleEs : i.titleEn} (${formatPrice(i.price)})`).join('\n');
      
      const message = isEs
        ? `¡Hola Ramia Studio! Quiero formalizar el siguiente encargo:\n${orderList}\nTotal estimado: ${formatPrice(total)}\n¿Tenéis disponibilidad para proceder con el envío?`
        : `Hello Ramia Studio! I'd like to place the following order:\n${orderList}\nEstimated total: ${formatPrice(total)}\nDo you have availability to proceed with shipping?`;
        
      const waUrl = `https://api.whatsapp.com/send?phone=34671259996&text=${encodeURIComponent(message)}`;
      window.open(waUrl, '_blank');
      
      setTimeout(() => {
        checkoutBtn.disabled = false;
        checkoutText?.classList.remove('hidden');
        checkoutLoader?.classList.add('hidden');
        checkoutLoader?.classList.remove('flex');
      }, 500);

      // --- PRESERVED STRIPE LOGIC (Commented out for now) ---
      /*
      try {
        const res = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items, lang: isEs ? 'es' : 'en' }),
        });
        const data = await res.json();
        
        if (data.url) {
          window.location.href = data.url;
        } else {
          console.error('Checkout error:', data.error);
          checkoutBtn.disabled = false;
          checkoutText?.classList.remove('hidden');
          checkoutLoader?.classList.add('hidden');
          checkoutLoader?.classList.remove('flex');
        }
      } catch (err) {
        console.error('Checkout request failed:', err);
        checkoutBtn.disabled = false;
        checkoutText?.classList.remove('hidden');
        checkoutLoader?.classList.add('hidden');
        checkoutLoader?.classList.remove('flex');
      }
      */
    });
  });
</script>



