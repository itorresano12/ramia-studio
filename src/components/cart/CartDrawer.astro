---
import { getProducts } from '../../lib/sanity';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const isEs = lang === 'es';
const enableStripe = import.meta.env.PUBLIC_ENABLE_STRIPE === 'true';

const allProducts = await getProducts();
const crossSellProducts = allProducts.slice(0, 3).map(p => ({
  id: p.id,
  title: p.title,
  price: p.price,
  imageStatic: p.imageStatic,
  slug: p.slug,
  weightGrams: p.weightGrams
}));
---

<!-- Overlay -->
<div id="cart-overlay" 
     class="fixed inset-0 bg-black/30 backdrop-blur-sm z-40 opacity-0 pointer-events-none transition-opacity duration-500 ease-out"
     aria-hidden="true"></div>

<!-- Drawer -->
<aside id="cart-drawer"
       class="fixed inset-y-0 right-0 max-w-md w-full bg-white/90 backdrop-blur-2xl border-l border-neutral-200/80 shadow-2xl z-50 translate-x-full transition-transform duration-500 ease-out h-[100dvh] max-h-[100dvh] flex flex-col"
       aria-label={isEs ? "Tu Bolsa" : "Your Bag"}>
       
  <!-- Header -->
  <header class="shrink-0 flex items-center justify-between px-6 py-5 border-b border-neutral-200/60">
    <h2 class="font-display text-2xl font-light text-neutral-900">
      {isEs ? "Tu Bolsa" : "Your Bag"}
      <span id="cart-header-count" class="text-neutral-600 text-lg ml-1">(0)</span>
    </h2>
    <button id="close-cart-btn"
            class="text-neutral-600 hover:text-neutral-900 transition-colors p-2 -mr-2"
            aria-label={isEs ? "Cerrar bolsa" : "Close bag"}>
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6 6 18M6 6l12 12"/>
      </svg>
    </button>
  </header>

  <!-- Progress Bar -->
  <div class="shrink-0 px-6 py-5 bg-neutral-50/80 border-b border-neutral-100">
    <p id="shipping-msg" class="font-body text-[11px] uppercase tracking-widest text-neutral-900 text-center mb-3">
      <!-- Injected via JS -->
    </p>
    <div class="h-0.5 w-full bg-neutral-200 rounded-full overflow-hidden">
      <div id="shipping-progress" class="h-full bg-neutral-900 transition-all duration-500 ease-out" style="width: 0%"></div>
    </div>
  </div>

  <!-- Cart Items Scroll Area -->
  <div class="flex-1 overflow-y-auto min-h-0 overscroll-contain p-4 md:px-6 md:py-6" id="cart-items-container">
    <!-- Items injected via JS -->
  </div>
  
  <!-- Empty State (hidden by default) -->
  <div id="cart-empty-state" class="hidden flex-col items-center justify-center flex-1 min-h-0 px-6 text-center">
    <div class="w-16 h-16 rounded-full bg-neutral-100 flex items-center justify-center mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-400">
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <path d="M16 10a4 4 0 0 1-8 0"/>
      </svg>
    </div>
    <p class="font-body text-neutral-500 tracking-wider text-sm uppercase mb-6">
      {isEs ? "Tu bolsa estÃ¡ vacÃ­a" : "Your bag is empty"}
    </p>
    <button id="continue-shopping-btn" class="text-[10px] font-body font-medium tracking-[0.18em] uppercase text-neutral-900 border-b border-neutral-900 pb-1 hover:text-neutral-500 hover:border-neutral-500 transition-colors">
      {isEs ? "Continuar explorando" : "Continue exploring"}
    </button>
  </div>

  <!-- Cross Sell Section -->
  <div id="cart-cross-sell" class="hidden shrink-0 px-6 py-5 border-t border-neutral-100 bg-neutral-50/50">
    <p class="font-body text-[10px] uppercase tracking-widest text-neutral-500 mb-4 text-center">
      {isEs ? "Combina perfectamente con" : "Pairs perfectly with"}
    </p>
    <div id="cross-sell-items" class="flex flex-col gap-3">
      {crossSellProducts.map(p => (
        <div class="cross-sell-item hidden flex items-center gap-4 bg-white p-3 rounded-2xl shadow-sm border border-neutral-200/50" data-id={p.id}>
          <a href={isEs ? `/producto/${p.slug}` : `/en/product/${p.slug}`} class="shrink-0 w-16 h-20 rounded-xl overflow-hidden bg-neutral-100">
            <img src={`${p.imageStatic}&w=100`} alt={p.title[lang]} class="w-full h-full object-cover" loading="lazy" />
          </a>
          <div class="flex-1 min-w-0 flex flex-col justify-center">
            <a href={isEs ? `/producto/${p.slug}` : `/en/product/${p.slug}`}>
              <h4 class="font-display text-sm text-neutral-900 truncate group-hover:text-neutral-500 transition-colors">{p.title[lang]}</h4>
            </a>
            <span class="font-body text-[10px] text-neutral-500 tracking-widest mt-1 uppercase">{p.weightGrams}g</span>
          </div>
          <button
            class="cross-sell-add shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-neutral-100 text-neutral-900 hover:bg-neutral-900 hover:text-white transition-colors"
            data-product={JSON.stringify(p)}
            aria-label={isEs ? `AÃ±adir ${p.title[lang]}` : `Add ${p.title[lang]}`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M12 5v14m-7-7h14"/>
            </svg>
          </button>
        </div>
      ))}
    </div>
  </div>

  <!-- Footer -->
  <footer id="cart-footer" class="shrink-0 border-t border-neutral-100 bg-white p-4 pb-8 pb-[calc(1.5rem+env(safe-area-inset-bottom))]">
    <div class="flex items-center justify-between mb-4">
      <span class="font-body text-sm text-neutral-500 uppercase tracking-widest">{isEs ? "Subtotal" : "Subtotal"}</span>
      <span id="cart-subtotal" class="font-display text-2xl font-light text-neutral-900 tracking-wider">0.00â‚¬</span>
    </div>
    
    <p class="text-[10px] text-neutral-600 font-body mb-6">
      {isEs ? "IVA incluido. " : "VAT included. "}
      <span id="cart-footer-shipping-text">{isEs ? "Gastos de envÃ­o calculados en el siguiente paso." : "Shipping costs calculated at checkout."}</span>
      <br/>
      <span class="text-neutral-500 italic font-display text-sm block mt-1">
        {isEs ? "DiseÃ±ados para no pesar." : "Designed to be weightless."}
      </span>
    </p>

    <div class="flex flex-col gap-3">
      {enableStripe && (
        <button id="stripe-checkout-btn" class="w-full bg-neutral-900 text-white font-body font-medium tracking-[0.18em] uppercase text-[10px] py-4 rounded-full hover:bg-neutral-800 transition-colors shadow-lg active:scale-[0.98]">
          {isEs ? "Pagar con tarjeta" : "Pay with card"}
        </button>
      )}
      
      <button id="checkout-btn" class={`w-full font-body font-medium tracking-[0.18em] uppercase text-[10px] py-4 rounded-full transition-colors active:scale-[0.98] ${enableStripe ? 'bg-transparent border border-neutral-300 text-neutral-900 hover:bg-neutral-50' : 'bg-neutral-900 text-white shadow-lg hover:bg-neutral-800'}`}>
        <span id="checkout-text">{isEs ? "Encargar vÃ­a WhatsApp" : "Order via WhatsApp"}</span>
        <span id="checkout-loader" class="hidden flex items-center justify-center gap-2">
          <svg class="animate-spin h-3 w-3 currentColor" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          {isEs ? 'Abriendo chat...' : 'Opening chat...'}
        </span>
      </button>
    </div>
  </footer>

</aside>

<script>
  import { isCartOpen, cartItems, cartTotal, cartCount, freeShippingProgress, closeCart, updateQuantity, removeItem, freeShippingThreshold } from '../../stores/cart';

  let unsubs: Array<() => void> = [];

  document.addEventListener('astro:page-load', () => {
    const lang = document.documentElement.lang;
    const isEs = lang === 'es';

    // Clean up previous subscriptions
    unsubs.forEach(unsub => unsub());
    unsubs = [];

    // DOM Elements
    const overlay = document.getElementById('cart-overlay');
    const drawer = document.getElementById('cart-drawer');
    const closeBtn = document.getElementById('close-cart-btn');
    const continueBtn = document.getElementById('continue-shopping-btn');
    
    const headerCount = document.getElementById('cart-header-count');
    const subtotalEl = document.getElementById('cart-subtotal');
    const itemsContainer = document.getElementById('cart-items-container');
    const emptyState = document.getElementById('cart-empty-state');
    const footer = document.getElementById('cart-footer');
    
    const shippingMsg = document.getElementById('shipping-msg');
    const shippingProgress = document.getElementById('shipping-progress');

    // Drawer Toggle Logic
    unsubs.push(isCartOpen.subscribe(open => {
      if (open) {
        overlay?.classList.remove('opacity-0', 'pointer-events-none');
        overlay?.classList.add('opacity-100', 'pointer-events-auto');
        drawer?.classList.remove('translate-x-full');
        document.body.style.overflow = 'hidden';
      } else {
        overlay?.classList.add('opacity-0', 'pointer-events-none');
        overlay?.classList.remove('opacity-100', 'pointer-events-auto');
        drawer?.classList.add('translate-x-full');
        document.body.style.overflow = '';
      }
    }));

    closeBtn?.addEventListener('click', closeCart);
    overlay?.addEventListener('click', closeCart);
    continueBtn?.addEventListener('click', closeCart);

    // Derived state subscriptions
    unsubs.push(cartCount.subscribe(count => {
      if (headerCount) headerCount.textContent = `(${count})`;
      
      if (count === 0) {
        itemsContainer?.classList.add('hidden');
        footer?.classList.add('hidden');
        emptyState?.classList.remove('hidden');
        emptyState?.classList.add('flex');
      } else {
        itemsContainer?.classList.remove('hidden');
        footer?.classList.remove('hidden');
        emptyState?.classList.add('hidden');
        emptyState?.classList.remove('flex');
      }
    }));

    const footerShippingText = document.getElementById('cart-footer-shipping-text');
    unsubs.push(cartTotal.subscribe(total => {
      if (subtotalEl) subtotalEl.textContent = `${total.toFixed(2)}â‚¬`;
      
      const remaining = freeShippingThreshold - total;
      if (shippingMsg) {
        if (remaining > 0) {
          shippingMsg.textContent = isEs 
            ? `Faltan ${remaining.toFixed(2)}â‚¬ para envÃ­o gratuito` 
            : `Add ${remaining.toFixed(2)}â‚¬ for free shipping`;
          if (footerShippingText) {
            footerShippingText.textContent = isEs 
              ? "Gastos de envÃ­o calculados en el siguiente paso." 
              : "Shipping costs calculated at checkout.";
          }
        } else {
          shippingMsg.textContent = isEs 
            ? `Â¡Tienes envÃ­o gratuito asegurado!` 
            : `You have secured free shipping!`;
          if (footerShippingText) {
            footerShippingText.textContent = isEs 
              ? "EnvÃ­o estÃ¡ndar gratuito aplicado." 
              : "Free standard shipping applied.";
          }
        }
      }
    }));

    unsubs.push(freeShippingProgress.subscribe(progress => {
      if (shippingProgress) shippingProgress.style.width = `${progress}%`;
    }));

    // Render Cart Items
    unsubs.push(cartItems.subscribe(items => {
      if (!itemsContainer) return;
      
      itemsContainer.innerHTML = '';
      
      items.forEach(item => {
        const title = isEs ? item.titleEs : item.titleEn;
        const closureLabel = item.closureSelected === 'clip' 
          ? (isEs ? 'OpciÃ³n Clip' : 'Clip Option')
          : (isEs ? 'Acero Inoxidable' : 'Stainless Steel');

        const itemEl = document.createElement('div');
        itemEl.className = 'flex gap-4 py-4 border-b border-neutral-100 last:border-0';
        
        itemEl.innerHTML = `
          <div class="w-20 h-24 shrink-0 bg-neutral-100 rounded-lg overflow-hidden shadow-sm">
            <img src="${item.image}" alt="${title}" class="w-full h-full object-cover" />
          </div>
          <div class="flex flex-col flex-1 justify-between py-0.5">
            <div>
              <div class="flex justify-between items-start gap-2">
                <h3 class="font-display text-lg text-neutral-900 leading-tight">${title}</h3>
                <button class="remove-item-btn text-neutral-600 hover:text-neutral-900 p-1 -mr-1 transition-colors" data-id="${item.id}" aria-label="Remove item">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 6 6 18M6 6l12 12"/>
                  </svg>
                </button>
              </div>
              <p class="text-[10px] font-body text-neutral-600 uppercase tracking-widest mt-1">${closureLabel}</p>
            </div>
            
            <div class="flex justify-between items-end">
              <div class="flex items-center gap-3 border border-neutral-200 rounded-full px-3 py-1 bg-white">
                <button class="qty-btn text-neutral-600 hover:text-neutral-900 transition-colors" data-id="${item.id}" data-action="minus" aria-label="Decrease quantity">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/></svg>
                </button>
                <span class="font-body text-xs font-medium text-neutral-900 min-w-[12px] text-center">${item.quantity}</span>
                <button class="qty-btn text-neutral-600 hover:text-neutral-900 transition-colors" data-id="${item.id}" data-action="plus" aria-label="Increase quantity">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                </button>
              </div>
              <span class="font-display text-lg text-neutral-900">${(item.price * item.quantity).toFixed(2)}â‚¬</span>
            </div>
          </div>
        `;
        itemsContainer.appendChild(itemEl);
      });

      // Attach event listeners
      itemsContainer.querySelectorAll('.remove-item-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).dataset.id;
          if (id) removeItem(id);
        });
      });

      itemsContainer.querySelectorAll('.qty-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const id = target.dataset.id;
          const action = target.dataset.action;
          if (!id || !action) return;
          
          const item = items.find(i => i.id === id);
          if (item) {
            updateQuantity(id, action === 'plus' ? item.quantity + 1 : item.quantity - 1);
          }
        });
      });

      // Cross-Selling Logic
      const crossSellContainer = document.getElementById('cross-sell-container');
      const crossSellItems = document.querySelectorAll('.cross-sell-item');
      
      let visibleCount = 0;
      const itemIdsInCart = items.map(i => i.productId);
      
      crossSellItems.forEach(el => {
        const pid = (el as HTMLElement).dataset.productId;
        if (pid && !itemIdsInCart.includes(pid) && visibleCount < 2) {
            el.classList.remove('hidden');
            visibleCount++;
        } else {
            el.classList.add('hidden');
        }
      });
      
      if (visibleCount > 0 && items.length > 0) {
          crossSellContainer?.classList.remove('hidden');
      } else {
          crossSellContainer?.classList.add('hidden');
      }
    }));

    // Attach listeners for Cross-Sell Add Buttons
    document.querySelectorAll('.add-cross-sell-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const productData = target.dataset.product;
        if (productData) {
          import('../../stores/cart').then(({ addItem }) => {
            const p = JSON.parse(productData);
            // Mock missing fields for addItem
            const fullProduct = { ...p, title: p.title }; 
            addItem(fullProduct, 'acero');
          });
        }
      });
    });

    // WhatsApp Checkout Integration (Concierge)
    const checkoutBtn = document.getElementById('checkout-btn') as HTMLButtonElement;
    const checkoutText = document.getElementById('checkout-text');
    const checkoutLoader = document.getElementById('checkout-loader');

    checkoutBtn?.addEventListener('click', async () => {
      const items = cartItems.get();
      if (items.length === 0) return;

      checkoutBtn.disabled = true;
      checkoutText?.classList.add('hidden');
      checkoutLoader?.classList.remove('hidden');
      checkoutLoader?.classList.add('flex');

      // WhatsApp Checkout logic
      const total = items.reduce((sum, i) => sum + i.price * i.quantity, 0).toFixed(2);
      let orderList = items.map(i => `- ${i.quantity}x ${isEs ? i.titleEs : i.titleEn} (${i.price.toFixed(2)}â‚¬)`).join('\n');
      
      const message = isEs
        ? `Â¡Hola Ramia Studio! Quiero formalizar el siguiente encargo:\n${orderList}\nTotal estimado: ${total}â‚¬\nÂ¿TenÃ©is disponibilidad para proceder con el envÃ­o?`
        : `Hello Ramia Studio! I'd like to place the following order:\n${orderList}\nEstimated total: ${total}â‚¬\nDo you have availability to proceed with shipping?`;
        
      const waUrl = `https://api.whatsapp.com/send?phone=34671259996&text=${encodeURIComponent(message)}`;
      window.open(waUrl, '_blank');
      
      setTimeout(() => {
        checkoutBtn.disabled = false;
        checkoutText?.classList.remove('hidden');
        checkoutLoader?.classList.add('hidden');
        checkoutLoader?.classList.remove('flex');
      }, 500);

      // --- PRESERVED STRIPE LOGIC (Commented out for now) ---
      /*
      try {
        const res = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items, lang: isEs ? 'es' : 'en' }),
        });
        const data = await res.json();
        
        if (data.url) {
          window.location.href = data.url;
        } else {
          console.error('Checkout error:', data.error);
          checkoutBtn.disabled = false;
          checkoutText?.classList.remove('hidden');
          checkoutLoader?.classList.add('hidden');
          checkoutLoader?.classList.remove('flex');
        }
      } catch (err) {
        console.error('Checkout request failed:', err);
        checkoutBtn.disabled = false;
        checkoutText?.classList.remove('hidden');
        checkoutLoader?.classList.add('hidden');
        checkoutLoader?.classList.remove('flex');
      }
      */
    });
  });
</script>

