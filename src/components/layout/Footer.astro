---
import { es } from '../../i18n/es';
import { en } from '../../i18n/en';
import { WHATSAPP_NUMBER, CONTACT_EMAIL } from '../../config/site';

interface Props {
  lang: 'es' | 'en';
}
const { lang } = Astro.props;
const t = lang === 'es' ? es : en;
const isEs = lang === 'es';
---

<footer class="bg-neutral-900 border-t border-neutral-800 text-neutral-100 py-16 px-6 sm:px-12 rounded-t-3xl mt-auto">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-12 lg:gap-8">
    
    <!-- Brand -->
    <div class="md:col-span-1">
      <a 
        href={isEs ? "/" : "/en"} 
        class="inline-block mb-4 group" 
        aria-label="Ramia Studio - Inicio"
      >
        <span class="font-display tracking-[0.25em] text-xl font-medium text-white uppercase group-hover:text-neutral-300 transition-colors">
          Ramia
        </span>
      </a>
      <p class="font-body text-xs text-neutral-400 leading-relaxed mb-4">
        {isEs ? 'Estudio de diseño creativo y joyería en metacrilato. Piezas artesanales diseñadas y montadas en España.' : 'Creative design studio and acrylic jewelry. Artisanal pieces designed and assembled in Spain.'}
      </p>
      <div class="flex gap-4">
        <a href="https://www.instagram.com/ramia.studio/" target="_blank" rel="noopener noreferrer" class="text-neutral-400 hover:text-white transition-colors" aria-label="Instagram">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37zM17.5 6.5h.01"/></svg>
        </a>
      </div>
    </div>

    <!-- Taller -->
    <div class="md:col-span-1">
      <h4 class="font-body text-[10px] tracking-[0.2em] uppercase text-neutral-400 mb-6">{isEs ? 'Taller' : 'Atelier'}</h4>
      <ul class="flex flex-col gap-4 font-body text-sm text-neutral-300">
        <li><a href={isEs ? '/#coleccion' : '/en/#coleccion'} class="hover:text-white transition-colors">{t.nav.collection}</a></li>
        <li><a href={isEs ? '/el-estudio' : '/en/studio'} class="hover:text-white transition-colors">{isEs ? 'El Taller' : 'The Atelier'}</a></li>
        <li><a href={isEs ? '/cuidados' : '/en/care-guide'} class="hover:text-white transition-colors">{isEs ? 'Guía de cuidados' : 'Care guide'}</a></li>
      </ul>
    </div>

    <!-- Taller y Ayuda -->
    <div class="md:col-span-1">
      <h4 class="font-body text-[10px] tracking-[0.2em] uppercase text-neutral-400 mb-6">{isEs ? 'Taller & Ayuda' : 'Atelier & Help'}</h4>
      <ul class="flex flex-col gap-4 font-body text-sm text-neutral-300">
        <li><a href={`https://wa.me/${WHATSAPP_NUMBER}`} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-2">{isEs ? 'Atención por WhatsApp' : 'WhatsApp Support'}</a></li>
        <li>
          <a href={`mailto:${CONTACT_EMAIL}`} 
             class="copy-email-btn hover:text-white transition-colors flex items-center gap-2"
             data-email={CONTACT_EMAIL}
             data-copied={isEs ? 'Copiado' : 'Copied'}>
            <span class="email-text">{CONTACT_EMAIL}</span>
          </a>
        </li>
      </ul>
    </div>

    <!-- Notas Legales -->
    <div class="md:col-span-1">
      <h4 class="font-body text-[10px] tracking-[0.2em] uppercase text-neutral-400 mb-6">{isEs ? 'Legales' : 'Legal'}</h4>
      <ul class="flex flex-col gap-4 font-body text-sm text-neutral-300">
        <li><a href={isEs ? '/aviso-legal' : '/en/legal-notice'} class="hover:text-white transition-colors">{isEs ? 'Aviso legal' : 'Legal Notice'}</a></li>
        <li><a href={isEs ? '/privacidad' : '/en/privacy'} class="hover:text-white transition-colors">{isEs ? 'Política de privacidad' : 'Privacy Policy'}</a></li>
        <li><a href={isEs ? '/terminos' : '/en/terms'} class="hover:text-white transition-colors">{isEs ? 'Términos de servicio' : 'Terms of Service'}</a></li>
      </ul>
    </div>

  </div>

  <!-- Copyright -->
  <div class="max-w-6xl mx-auto mt-16 pt-6 pb-12 border-t border-neutral-800 flex flex-col items-center gap-2 text-center text-xs text-neutral-400 font-light tracking-wide">
    <p class="font-body text-[10px] tracking-[0.2em] uppercase">
      © {new Date().getFullYear()} RAMIA STUDIO. {isEs ? 'TODOS LOS DERECHOS RESERVADOS.' : 'ALL RIGHTS RESERVED.'}
    </p>
    <p>
      {isEs ? 'Diseño: ' : 'Design by '}
<a 
  href="https://www.linkedin.com/in/ivan-torresano-canalejas-990b64187/" 
  target="_blank" 
  rel="noopener noreferrer" 
  class="hover:text-neutral-200 transition-colors underline underline-offset-4 decoration-neutral-700"
>
  Iván Torresano
</a>
    </p>
  </div>
</footer>

