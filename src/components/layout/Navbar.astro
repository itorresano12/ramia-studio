---
import { es } from '../../i18n/es';
import { en } from '../../i18n/en';

interface Props {
  lang: 'es' | 'en';
  productSlug?: string;
}
const { lang, productSlug } = Astro.props;
const t = lang === 'es' ? es : en;

const isEs = lang === 'es';
const esUrl = productSlug ? `/producto/${productSlug}` : '/';
const enUrl = productSlug ? `/en/product/${productSlug}` : '/en';
---

<!--
  âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§
   FIXED NAV - Always frosted/opaque
  âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§ âœ§
-->
<div id="navbar-wrapper" class="sticky top-6 z-40 mx-auto w-[92%] md:w-full md:max-w-2xl lg:max-w-3xl px-4 pointer-events-none">
  <nav id="navbar"
       class="navbar pointer-events-auto relative w-full bg-white/90 backdrop-blur-md border border-neutral-200/70 shadow-sm rounded-full px-5 py-2.5 md:px-8 md:py-3.5 flex items-center justify-between"
  >

    <!-- ── Brand ── -->
    <a href={isEs ? '/' : '/en'}
       class="flex items-center gap-2 shrink-0 group"
       aria-label="Ramia Studio — Inicio">
      <!-- Logo Image: hidden by default, shown via onload when file exists -->
      <img
        src="/logo.png"
        alt="Ramia Studio"
        width="120"
        height="32"
        class="h-6 md:h-8 w-auto object-contain transition-opacity group-hover:opacity-60"
        style="display:none"
        onload="this.style.display='inline';this.nextElementSibling.style.display='none';"
        loading="eager"
        decoding="async"
      />
      <!-- Fallback text: always visible until logo.svg loads -->
      <span class="text-xl md:text-2xl lg:text-3xl font-display md:font-serif tracking-[0.25em] md:tracking-tight text-neutral-900 uppercase md:normal-case group-hover:text-neutral-500 transition-colors">
        Ramia
      </span>
    </a>

    <!-- ── Centre nav (desktop) ── -->
    <ul class="hidden md:flex items-center gap-6 md:gap-10">
      <li>
        <a href={isEs ? '/#coleccion' : '/en#coleccion'}
           class="text-xs md:text-sm font-body font-medium tracking-[0.18em] uppercase text-neutral-600 hover:text-black transition-colors">
          {t.nav.collection}
        </a>
      </li>
      <li>
        <a href={isEs ? '/el-estudio' : '/en/studio'}
           class="text-xs md:text-sm font-body font-medium tracking-[0.18em] uppercase text-neutral-600 hover:text-black transition-colors">
          {lang === 'es' ? 'El Taller' : 'The Atelier'}
        </a>
      </li>
    </ul>

    <!-- ── Right controls ── -->
    <div class="flex items-center gap-4 shrink-0">

      <!-- Lang switcher -->
      <div class="hidden sm:flex items-center gap-1 text-[10px] md:text-sm font-body font-medium tracking-[0.12em]">
        <a href={esUrl}
           class={`px-2 py-0.5 rounded-full transition-colors duration-150 ${isEs ? 'bg-neutral-900 text-white' : 'text-neutral-600 hover:text-neutral-700'}`}
           aria-label="Cambiar a español">
          ES
        </a>
        <span class="text-neutral-300 select-none">|</span>
        <a href={enUrl}
           class={`px-2 py-0.5 rounded-full transition-colors duration-150 ${!isEs ? 'bg-neutral-900 text-white' : 'text-neutral-600 hover:text-neutral-700'}`}
           aria-label="Switch to English">
          EN
        </a>
      </div>

      <!-- Cart button -->
      <button id="cart-btn"
              aria-label={t.nav.cart}
              class="relative flex items-center text-neutral-600 hover:text-neutral-900
                     transition-colors duration-200 group">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none"
             viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4"
             stroke-linecap="round" stroke-linejoin="round"
             class="w-5 h-5 md:w-6 md:h-6">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span id="cart-count"
              class="absolute -top-1.5 -right-1.5 min-w-[18px] h-[18px] md:min-w-[20px] md:h-[20px] px-1
                     rounded-full bg-neutral-900 text-white text-[10px] md:text-xs
                     font-medium font-body flex items-center justify-center
                     leading-none hidden">
          0
        </span>
      </button>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn"
              class="md:hidden relative flex items-center text-neutral-600 hover:text-neutral-900 transition-colors ml-1"
              aria-label="Menu">
        <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

    </div>
  </nav>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu-dropdown" class="absolute top-full mt-2 left-4 right-4 bg-[#FAF8F5] shadow-xl border border-neutral-200/60 rounded-3xl p-6 flex flex-col gap-6 opacity-0 pointer-events-none -translate-y-2 transition-all duration-300 z-40">
    <a href={isEs ? '/#coleccion' : '/en#coleccion'} class="mobile-nav-link text-xs font-body font-medium tracking-[0.18em] uppercase text-neutral-900 text-center hover:text-neutral-500">
      {t.nav.collection}
    </a>
    <a href={isEs ? '/el-estudio' : '/en/studio'} class="mobile-nav-link text-xs font-body font-medium tracking-[0.18em] uppercase text-neutral-900 text-center hover:text-neutral-500">
      {lang === 'es' ? 'El Taller' : 'The Atelier'}
    </a>
    
    <!-- Lang switcher Mobile -->
    <div class="flex items-center justify-center gap-2 mt-2 pt-6 border-t border-neutral-200/60">
      <a href={esUrl} class={`text-[10px] font-body tracking-[0.18em] px-3 py-1 rounded-full ${isEs ? 'bg-neutral-900 text-white' : 'text-neutral-500 border border-neutral-200'}`}>ES</a>
      <a href={enUrl} class={`text-[10px] font-body tracking-[0.18em] px-3 py-1 rounded-full ${!isEs ? 'bg-neutral-900 text-white' : 'text-neutral-500 border border-neutral-200'}`}>EN</a>
    </div>
  </div>
</div>

<script>
  import { openCart, cartCount } from '../../stores/cart';

  let navbarUnsubs: Array<() => void> = [];

  document.addEventListener('astro:page-load', () => {
    navbarUnsubs.forEach(unsub => unsub());
    navbarUnsubs = [];

    // âœ§ Cart âœ§
    const cartBtn = document.getElementById('cart-btn');
    const cartBadge = document.getElementById('cart-count');

    cartBtn?.addEventListener('click', () => {
      openCart();
    });

    navbarUnsubs.push(cartCount.subscribe(count => {
      if (cartBadge) {
        if (count > 0) {
          cartBadge.textContent = count.toString();
          cartBadge.classList.remove('hidden');
        } else {
          cartBadge.classList.add('hidden');
        }
      }
    }));

    // âœ§ Mobile Menu âœ§
    const menuBtn = document.getElementById('mobile-menu-btn');
    const menuDropdown = document.getElementById('mobile-menu-dropdown');
    const menuIconOpen = document.getElementById('menu-icon-open');
    const menuIconClose = document.getElementById('menu-icon-close');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');
    let isMenuOpen = false;

    function toggleMenu() {
      isMenuOpen = !isMenuOpen;
      if (isMenuOpen) {
        menuDropdown?.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-2');
        menuDropdown?.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
        menuIconOpen?.classList.add('hidden');
        menuIconClose?.classList.remove('hidden');
      } else {
        menuDropdown?.classList.add('opacity-0', 'pointer-events-none', '-translate-y-2');
        menuDropdown?.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
        menuIconOpen?.classList.remove('hidden');
        menuIconClose?.classList.add('hidden');
      }
    }

    menuBtn?.addEventListener('click', toggleMenu);
    
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (isMenuOpen) toggleMenu();
      });
    });
  });
</script>

