---
// Navbar — Glassmorphism floating pill
---

<header class="fixed top-0 left-0 right-0 z-50 px-4 pointer-events-none">
  <nav class="pointer-events-auto max-w-5xl mx-auto my-4 px-8 py-3.5 flex items-center justify-between
              backdrop-blur-xl bg-white/70 border border-white/60
              shadow-[0_8px_32px_0_rgba(0,0,0,0.04)]
              rounded-full">

    <!-- Logo -->
    <a href="/"
       class="font-display tracking-[0.25em] text-base font-medium text-neutral-900 hover:text-neutral-600 transition-colors duration-200 uppercase select-none">
      Ramia
    </a>

    <!-- Centre links (hidden on mobile) -->
    <ul class="hidden md:flex items-center gap-8">
      <li>
        <a href="#coleccion"
           class="text-[11px] tracking-[0.18em] uppercase text-neutral-500 hover:text-neutral-900 transition-colors duration-200 font-body font-medium">
          Colección
        </a>
      </li>
      <li>
        <a href="#manifiesto"
           class="text-[11px] tracking-[0.18em] uppercase text-neutral-500 hover:text-neutral-900 transition-colors duration-200 font-body font-medium">
          El Manifiesto
        </a>
      </li>
      <li>
        <a href="#material"
           class="text-[11px] tracking-[0.18em] uppercase text-neutral-500 hover:text-neutral-900 transition-colors duration-200 font-body font-medium">
          Metacrilato&nbsp;&amp;&nbsp;Titanio
        </a>
      </li>
    </ul>

    <!-- Cart -->
    <button
      aria-label="Abrir carrito"
      class="relative flex items-center gap-2 text-neutral-600 hover:text-neutral-900 transition-colors duration-200 group"
    >
      <!-- Cart icon -->
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24"
           stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <path d="M16 10a4 4 0 0 1-8 0"/>
      </svg>
      <!-- Badge -->
      <span id="cart-count"
            class="absolute -top-1.5 -right-1.5 min-w-[16px] h-4 px-1 rounded-full bg-neutral-900 text-white text-[9px] font-medium font-body flex items-center justify-center leading-none hidden">
        0
      </span>
    </button>

  </nav>
</header>

<!-- Spacer so content doesn't hide under fixed nav -->
<div class="h-[72px]" aria-hidden="true"></div>
