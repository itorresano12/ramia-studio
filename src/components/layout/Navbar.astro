---
import { es } from '../../i18n/es';
import { en } from '../../i18n/en';

interface Props {
  lang: 'es' | 'en';
  productSlug?: string;
}
const { lang, productSlug } = Astro.props;
const t = lang === 'es' ? es : en;

const isEs = lang === 'es';
const esUrl = productSlug ? `/producto/${productSlug}` : '/';
const enUrl = productSlug ? `/en/product/${productSlug}` : '/en';
---

<!--
  ═══════════════════════════════════════════════
   STICKY NAV — transparent on load, activates at 120px scroll
  ═══════════════════════════════════════════════
-->
<div id="navbar-wrapper" class="sticky top-4 z-50 max-w-6xl mx-auto px-4 sm:px-6 pointer-events-none">
  <nav id="navbar"
       class="navbar pointer-events-auto flex items-center justify-between
              px-5 py-3 rounded-full border
              transition-all duration-300 ease-out
              border-transparent bg-transparent
              shadow-none"
  >

    <!-- ── Brand ── -->
    <a href={isEs ? '/' : '/en'}
       class="flex items-center gap-2 shrink-0 group"
       aria-label="Ramia Studio — Inicio">
      <img
        src="/logo.svg"
        alt="Ramia Studio"
        width="96"
        height="28"
        class="h-7 w-auto object-contain transition-opacity group-hover:opacity-60"
        onerror="this.style.display='none';this.nextElementSibling.style.display='inline';"
        loading="eager"
        decoding="async"
      />
      <span class="font-display font-light text-xl uppercase tracking-[0.25em] text-neutral-900 group-hover:text-neutral-500 transition-colors"
            style="display:none">
        Ramia
      </span>
    </a>

    <!-- ── Centre nav (desktop) ── -->
    <ul class="hidden md:flex items-center gap-7">
      <li>
        <a href={isEs ? '/#coleccion' : '/en#coleccion'}
           class="text-[11px] font-body font-medium tracking-[0.18em] uppercase
                  text-neutral-500 hover:text-neutral-900 transition-colors duration-200">
          {t.nav.collection}
        </a>
      </li>
      <li>
        <a href={isEs ? '/el-estudio' : '/en/studio'}
           class="text-[11px] font-body font-medium tracking-[0.18em] uppercase
                  text-neutral-500 hover:text-neutral-900 transition-colors duration-200">
          {lang === 'es' ? 'El Estudio' : 'The Studio'}
        </a>
      </li>
      <li>
        <a href={isEs ? '/#material' : '/en#material'}
           class="text-[11px] font-body font-medium tracking-[0.18em] uppercase
                  text-neutral-500 hover:text-neutral-900 transition-colors duration-200">
          {lang === 'es' ? 'Taller' : 'Atelier'}
        </a>
      </li>
    </ul>

    <!-- ── Right controls ── -->
    <div class="flex items-center gap-4 shrink-0">

      <!-- Lang switcher -->
      <div class="hidden sm:flex items-center gap-1 text-[10px] font-body font-medium tracking-[0.12em]">
        <a href={esUrl}
           class={`px-2 py-0.5 rounded-full transition-colors duration-150 ${isEs ? 'bg-neutral-900 text-white' : 'text-neutral-600 hover:text-neutral-700'}`}
           aria-label="Cambiar a español">
          ES
        </a>
        <span class="text-neutral-300 select-none">|</span>
        <a href={enUrl}
           class={`px-2 py-0.5 rounded-full transition-colors duration-150 ${!isEs ? 'bg-neutral-900 text-white' : 'text-neutral-600 hover:text-neutral-700'}`}
           aria-label="Switch to English">
          EN
        </a>
      </div>

      <!-- Cart button -->
      <button id="cart-btn"
              aria-label={t.nav.cart}
              class="relative flex items-center text-neutral-600 hover:text-neutral-900
                     transition-colors duration-200 group">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none"
             viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4"
             stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span id="cart-count"
              class="absolute -top-1.5 -right-1.5 min-w-[16px] h-4 px-1
                     rounded-full bg-neutral-900 text-white text-[9px]
                     font-medium font-body flex items-center justify-center
                     leading-none hidden">
          0
        </span>
      </button>

    </div>
  </nav>
</div>

<!-- Spacer below sticky nav -->
<div class="h-4" aria-hidden="true"></div>

<script>
  import { openCart, cartCount } from '../../stores/cart';

  let navbarUnsubs: Array<() => void> = [];

  document.addEventListener('astro:page-load', () => {
    navbarUnsubs.forEach(unsub => unsub());
    navbarUnsubs = [];

    // ── Scroll-triggered activation ──
    const navbar = document.getElementById('navbar');
    const SCROLL_THRESHOLD = 120;

    function updateNavbar() {
      if (!navbar) return;
      if (window.scrollY > SCROLL_THRESHOLD) {
        navbar.classList.add(
          'backdrop-blur-md', 'bg-white/95',
          'border-neutral-200/60', 'shadow-sm'
        );
        navbar.classList.remove('border-transparent', 'bg-transparent', 'shadow-none');
      } else {
        navbar.classList.remove(
          'backdrop-blur-md', 'bg-white/95',
          'border-neutral-200/60', 'shadow-sm'
        );
        navbar.classList.add('border-transparent', 'bg-transparent', 'shadow-none');
      }
    }

    // Run immediately in case page loads mid-scroll
    updateNavbar();
    window.addEventListener('scroll', updateNavbar, { passive: true });

    // ── Cart ──
    const cartBtn = document.getElementById('cart-btn');
    const cartBadge = document.getElementById('cart-count');

    cartBtn?.addEventListener('click', () => {
      openCart();
    });

    navbarUnsubs.push(cartCount.subscribe(count => {
      if (cartBadge) {
        if (count > 0) {
          cartBadge.textContent = count.toString();
          cartBadge.classList.remove('hidden');
        } else {
          cartBadge.classList.add('hidden');
        }
      }
    }));
  });
</script>
