---
// Navbar — Glassmorphism floating pill with i18n switcher + cart
const currentPath = Astro.url.pathname;
---

<div class="sticky top-4 z-50 max-w-6xl mx-auto px-4 sm:px-6 pointer-events-none">
  <nav class="pointer-events-auto flex items-center justify-between
              px-6 py-3.5 rounded-full
              backdrop-blur-xl bg-white/75 border border-white/70
              shadow-[0_8px_30px_rgb(0,0,0,0.04)]">

    <!-- ── Brand ── -->
    <a href="/"
       class="font-display tracking-[0.25em] text-base font-medium text-neutral-900
              hover:text-neutral-500 transition-colors duration-200 uppercase select-none shrink-0">
      Ramia
    </a>

    <!-- ── Centre nav (desktop) ── -->
    <ul class="hidden md:flex items-center gap-7">
      <li>
        <a href="#coleccion"
           class="text-[11px] font-body font-medium tracking-[0.18em] uppercase
                  text-neutral-500 hover:text-neutral-900 transition-colors duration-200">
          Colección
        </a>
      </li>
      <li>
        <a href="#manifiesto"
           class="text-[11px] font-body font-medium tracking-[0.18em] uppercase
                  text-neutral-500 hover:text-neutral-900 transition-colors duration-200">
          El Manifiesto
        </a>
      </li>
      <li>
        <a href="#material"
           class="text-[11px] font-body font-medium tracking-[0.18em] uppercase
                  text-neutral-500 hover:text-neutral-900 transition-colors duration-200">
          Metacrilato&nbsp;&amp;&nbsp;Titanio
        </a>
      </li>
    </ul>

    <!-- ── Right controls ── -->
    <div class="flex items-center gap-4 shrink-0">

      <!-- Lang switcher -->
      <div class="hidden sm:flex items-center gap-1 text-[10px] font-body font-medium tracking-[0.12em]">
        <button id="lang-es"
                class="lang-btn px-2 py-0.5 rounded-full transition-colors duration-150
                       bg-neutral-900 text-white"
                data-lang="es" aria-label="Cambiar a español">
          ES
        </button>
        <span class="text-neutral-300 select-none">|</span>
        <button id="lang-en"
                class="lang-btn px-2 py-0.5 rounded-full transition-colors duration-150
                       text-neutral-400 hover:text-neutral-700"
                data-lang="en" aria-label="Switch to English">
          EN
        </button>
      </div>

      <!-- Cart button -->
      <button id="cart-btn"
              aria-label="Abrir bolsa de compra"
              class="relative flex items-center text-neutral-600 hover:text-neutral-900
                     transition-colors duration-200 group">
        <!-- Bag icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none"
             viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4"
             stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <!-- Badge -->
        <span id="cart-count"
              class="absolute -top-1.5 -right-1.5 min-w-[16px] h-4 px-1
                     rounded-full bg-neutral-900 text-white text-[9px]
                     font-medium font-body flex items-center justify-center
                     leading-none hidden">
          0
        </span>
      </button>

    </div>
  </nav>
</div>

<!-- Spacer below sticky nav -->
<div class="h-6" aria-hidden="true"></div>

<script>
  // ── Lang switcher ──────────────────────────────────────────────
  const langBtns = document.querySelectorAll<HTMLButtonElement>('.lang-btn');
  langBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      langBtns.forEach(b => {
        b.classList.remove('bg-neutral-900', 'text-white');
        b.classList.add('text-neutral-400');
      });
      btn.classList.add('bg-neutral-900', 'text-white');
      btn.classList.remove('text-neutral-400');
      // Dispatch event for other components to react
      document.dispatchEvent(new CustomEvent('langchange', { detail: btn.dataset.lang }));
    });
  });
</script>
