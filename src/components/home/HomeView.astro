---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../product/ProductCard.astro';
import { getProducts } from '../../lib/sanity';
import { es } from '../../i18n/es';
import { en } from '../../i18n/en';
import { Image } from 'astro:assets';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = lang === 'es' ? es : en;

const products = await getProducts();

const guarantees = [
  { label: t.guarantees.titanium },
  { label: t.guarantees.ultralight },
  { label: t.guarantees.noDamage },
];

const filters = [
  { id: 'all',        label: t.filters.all },
  { id: 'pendientes', label: t.filters.earrings },
  { id: 'colgantes',  label: t.filters.necklaces },
  { id: 'charms',     label: t.filters.charms },
  { id: 'packs',      label: 'Packs' },
];

const weights = [
  { label: lang === 'es' ? 'Pendiente Ramia' : 'Ramia Earring', grams: 2.6, note: lang === 'es' ? 'ultraligero' : 'ultralight', highlight: true },
  { label: lang === 'es' ? 'Moneda 50 céntimos' : '50 Cent Coin', grams: 7.8, note: lang === 'es' ? '3× más pesada' : '3× heavier', highlight: false },
  { label: lang === 'es' ? 'Moneda 2 euros' : '2 Euro Coin', grams: 8.5, note: lang === 'es' ? 'más del triple' : 'more than triple', highlight: false },
];
const maxWeight = Math.max(...weights.map(w => w.grams));
---

<Layout title={`Ramia — ${t.hero.title}`} lang={lang}>

  <!-- ═══════════════════════════════════════════
       HERO — 2-Column Editorial
  ══════════════════════════════════════════════ -->
  <section class="relative overflow-hidden px-6 pt-10 pb-16 max-w-7xl mx-auto">
    <!-- Ambient blob -->
    <div class="pointer-events-none absolute -top-24 left-1/4 -translate-x-1/2 w-[800px] h-[500px] rounded-full opacity-20"
         style="background:radial-gradient(ellipse at center,rgba(200,188,240,0.6) 0%,transparent 68%);filter:blur(72px);"
         aria-hidden="true"></div>

    <div class="grid md:grid-cols-2 gap-12 items-center min-h-[75vh] py-8">
      
      <!-- Columna Izquierda (Narrativa) -->
      <div class="flex flex-col text-left justify-center pt-10 md:pt-0 z-10">
        <p class="font-body text-[10px] tracking-[0.28em] uppercase text-neutral-600 mb-6 select-none">
          {lang === 'es' ? 'ESTUDIO DE DISEÑO EN METACRILATO · CORTE LÁSER & ARTESANÍA' : 'ACRYLIC DESIGN STUDIO · LASER CUT & CRAFTSMANSHIP'}
        </p>
        
        <h1 class="font-display text-4xl sm:text-5xl lg:text-7xl font-light text-neutral-900 tracking-tight mb-8 leading-[1.1]">
          <span class="sr-only">Ramia Studio &middot; </span>
          {lang === 'es' ? 'Mucho diseño.' : 'Bold design.'}<br/>
          {lang === 'es' ? 'Cero peso.' : 'Zero weight.'}
        </h1>
        
        <p class="font-body text-neutral-600 leading-relaxed mb-10 max-w-md text-sm md:text-base">
          {lang === 'es' 
            ? 'Nuestras piezas desafían la gravedad. Diseños escultóricos y audaces que puedes llevar todo el día con absoluta comodidad gracias a la extrema ligereza del metacrilato.'
            : 'Our pieces defy gravity. Sculptural and bold designs you can wear all day in absolute comfort thanks to the extreme lightness of acrylic.'}
        </p>

        <!-- Guarantee pills -->
        <div class="flex flex-wrap items-center gap-3">
          {guarantees.map(g => (
            <span class="inline-flex items-center gap-2 bg-neutral-50/50
                         border border-neutral-200 text-xs font-body
                         text-neutral-600 px-3 py-1 rounded-full
                         shadow-sm select-none">
              <span class="text-neutral-300 text-[8px]">✦</span>
              {g.label}
            </span>
          ))}
        </div>
      </div>

      <!-- Columna Derecha (Impacto Visual) -->
      <div class="w-full relative z-10 flex justify-center md:justify-end mt-8 md:mt-0">
        <img
          src="https://images.unsplash.com/photo-1611591437281-460bfbe1220a?auto=format&fit=crop&w=1200&q=85"
          alt={lang === 'es' ? 'Joyería contemporánea en metacrilato' : 'Contemporary acrylic jewelry'}
          class="aspect-[4/5] object-cover rounded-2xl shadow-sm w-full max-w-md bg-neutral-100"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       WEIGHT REASSURANCE MODULE
  ══════════════════════════════════════════════ -->
  <section id="material" class="max-w-3xl mx-auto px-6 py-16">
    <div class="text-center mb-10">
      <p class="font-body text-[10px] tracking-[0.3em] uppercase text-neutral-600 mb-3">
        {lang === 'es' ? 'Comparador de Ligereza' : 'Lightness Comparator'}
      </p>
      <h2 class="font-display text-3xl md:text-4xl font-light text-neutral-900 mb-4" set:html={lang === 'es' ? '¿Cuánto pesan realmente<br/>tus Ramia?' : 'How much do your<br/>Ramia earrings weigh?'}>
      </h2>
      <p class="font-body text-sm text-neutral-500 max-w-md mx-auto">
        {lang === 'es' ? 'Diseñados para olvidar que los llevas puestos durante más de 12 horas seguidas.' : 'Designed to make you forget you are wearing them for over 12 hours straight.'}
      </p>
    </div>

    <!-- Weight bars (Precision Scale) -->
    <div class="flex flex-col gap-8 max-w-xl mx-auto mt-12">
      {weights.map(w => (
        <div class="flex flex-col gap-2 relative group">
          <div class="flex justify-between items-end mb-1">
            <span class={`font-body text-[11px] tracking-widest uppercase ${w.highlight ? 'text-neutral-900 font-semibold' : 'text-neutral-500'}`}>
              {w.label} <span class="normal-case text-[10px] tracking-normal text-neutral-400 ml-1">· {w.note}</span>
            </span>
            <span class={`font-mono text-sm tracking-wider ${w.highlight ? 'text-neutral-900 font-medium' : 'text-neutral-500'}`}>
              {w.grams.toFixed(1)} g
            </span>
          </div>
          <div class="w-full h-[2px] bg-neutral-200 relative overflow-hidden">
            <div 
              class={`absolute top-0 left-0 h-full transition-all duration-1000 ease-out origin-left ${w.highlight ? 'bg-neutral-900' : 'bg-neutral-400'}`}
              style={`width:${(w.grams / maxWeight) * 100}%`}
            ></div>
          </div>
        </div>
      ))}
    </div>

    <!-- Authority note -->
    <p class="font-body text-xs text-neutral-500 text-center mt-12 mb-4">
      {lang === 'es' ? 'Diseñados para olvidar que los llevas puestos durante toda la jornada.' : 'Designed to forget you are wearing them throughout the entire day.'}
    </p>
  </section>

  <!-- ═══════════════════════════════════════════
       COLLECTION FILTERS + GRID
  ══════════════════════════════════════════════ -->
  <section id="coleccion" class="max-w-6xl mx-auto px-4 pb-28">

    <!-- Section label -->
    <div class="text-center mb-8">
      <p class="font-body text-[10px] tracking-[0.3em] uppercase text-neutral-600">
        {t.nav.collection}&ensp;·&ensp;{products.length}&nbsp;{lang === 'es' ? 'piezas disponibles' : 'pieces available'}
      </p>
    </div>

    <!-- Filter pills -->
    <div class="flex gap-2 overflow-x-auto pb-3 mb-10 scrollbar-hide justify-start md:justify-center">
      {filters.map(f => (
        <button
          class="filter-btn shrink-0 text-[10px] font-body font-medium tracking-[0.15em]
                 uppercase px-4 py-2 rounded-full border transition-all duration-200
                 whitespace-nowrap
                 border-transparent bg-neutral-100 text-neutral-700 hover:bg-neutral-200"
          data-filter={f.id}
          aria-label={f.label}
        >
          {f.label}
        </button>
      ))}
    </div>

    <!-- Grid -->
    <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {products.map((product: any) => (
        <ProductCard product={product} lang={lang} />
      ))}
    </div>

    <!-- Empty state -->
    <p id="empty-state"
       class="hidden text-center font-display italic text-neutral-600 text-lg py-20">
      {lang === 'es' ? 'Nuevas piezas en camino. Próximamente.' : 'New pieces on the way. Coming soon.'}
    </p>
  </section>

  <!-- ═══════════════════════════════════════════
       MANIFESTO
  ══════════════════════════════════════════════ -->
  <section id="manifiesto" class="max-w-3xl mx-auto px-6 py-20 text-center border-t border-neutral-200/60 mt-10">
    <p class="font-body text-[10px] tracking-[0.3em] uppercase text-neutral-600 mb-8">
      {t.nav.manifesto}
    </p>
    <blockquote class="font-display italic text-3xl md:text-4xl font-light text-neutral-800 leading-relaxed">
      "{lang === 'es' ? 'Cada pieza nace de la convicción de que la joyería más poderosa es la que no se siente.' : 'Every piece is born from the conviction that the most powerful jewelry is the one you do not feel.'}"
    </blockquote>
  </section>

</Layout>

<!-- ═══════════════════════════════════════════
     COLLECTION FILTER — client-side JS
══════════════════════════════════════════════ -->
<script>
  type FilterId = 'all' | 'pendientes' | 'colgantes' | 'charms' | 'packs';

  document.addEventListener('astro:page-load', () => {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards      = document.querySelectorAll<HTMLElement>('.product-card');
    const emptyState = document.getElementById('empty-state');

    let activeFilter: FilterId = 'all';

    function applyFilter(filterId: FilterId) {
      activeFilter = filterId;

      // Update button styles
      filterBtns.forEach(btn => {
        const isActive = btn.dataset.filter === filterId;
        btn.classList.toggle('bg-neutral-900',  isActive);
        btn.classList.toggle('text-white',       isActive);
        btn.classList.toggle('bg-neutral-100', !isActive);
        btn.classList.toggle('text-neutral-700',  !isActive);
        btn.classList.toggle('hover:bg-neutral-200', !isActive);
      });

      // Show/hide cards
      let visible = 0;
      cards.forEach(card => {
        const category = card.dataset.category as string;

        const show =
          filterId === 'all' ||
          category === filterId;

        card.style.transition = 'opacity 0.3s ease, transform 0.3s ease';

        if (show) {
          card.style.opacity    = '1';
          card.style.transform  = 'scale(1)';
          card.style.pointerEvents = 'auto';
          card.style.display    = 'flex';
          visible++;
        } else {
          card.style.opacity    = '0';
          card.style.transform  = 'scale(0.97)';
          card.style.pointerEvents = 'none';
          // Collapse after transition
          setTimeout(() => {
            if (activeFilter !== 'all' && !card.style.opacity.startsWith('1')) {
              card.style.display = 'none';
            }
          }, 320);
        }
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', visible > 0);
      }
    }

    if (filterBtns.length > 0) {
      // Set first button active on load
      applyFilter('all');

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          applyFilter(btn.dataset.filter as FilterId);
        });
      });
    }
  });
</script>

<style>
  /* Hide scrollbar on filter row */
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>
