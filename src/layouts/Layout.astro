---
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import CartDrawer from '../components/cart/CartDrawer.astro';
import CookieBanner from '../components/common/CookieBanner.astro';

interface Props {
  title: string;
  lang: 'es' | 'en';
  productSlug?: string;
  description?: string;
  ogImage?: string;
}

const { 
  title, 
  lang, 
  productSlug, 
  description = "Ramia Studio — Joyería de diseño contemporáneo en metacrilato. Mucho diseño. Cero peso.",
  ogImage = "https://images.unsplash.com/photo-1599643478514-46b14245b11c?q=80&w=1200&h=630&auto=format&fit=crop"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://ramiastudio.com');

// Calculate hreflang paths dynamically
const esPath = lang === 'es' ? Astro.url.pathname : Astro.url.pathname.replace(/^\/en/, '');
const enPath = lang === 'en' ? Astro.url.pathname : `/en${Astro.url.pathname === '/' ? '' : Astro.url.pathname}`;
const esURL = new URL(esPath || '/', Astro.site || 'https://ramiastudio.com');
const enURL = new URL(enPath, Astro.site || 'https://ramiastudio.com');
---

<!doctype html>
<html lang={lang} class="w-full max-w-full overflow-x-clip">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <!-- SEO & Metadata -->
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Hreflang -->
    <link rel="alternate" hreflang="es" href={esURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="x-default" href={esURL} />

    <!-- OpenGraph -->
    <meta property="og:site_name" content="Ramia Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={productSlug ? "product" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

  <!-- Google Fonts Preconnect & Async Stylesheet -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Plus+Jakarta+Sans:wght@300;400;500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Plus+Jakarta+Sans:wght@300;400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Plus+Jakarta+Sans:wght@300;400;500&display=swap"
      />
    </noscript>

    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="bg-[#FAF8F5] pt-20 md:pt-24 flex flex-col min-h-screen w-full max-w-full overflow-x-clip">
    <Navbar lang={lang} productSlug={productSlug} />
    <main id="main-content" class="flex-1 w-full">
      <slot />
    </main>
    <Footer lang={lang} />
    <CartDrawer lang={lang} />
    <CookieBanner lang={lang} />

    <!-- Universal Mailto Intercept -->
    <script>
      function setupMailtoIntercept() {
        const mailtoLinks = document.querySelectorAll('a[href^="mailto:"]');
        
        function handleMailtoClick(e) {
          e.preventDefault();
          e.stopPropagation();

          const link = e.currentTarget;
          const rawHref = link.getAttribute('href') || '';
          const email = rawHref.replace(/^mailto:/i, '').split('?')[0].trim();
          if (!email) return;

          const isEs = document.documentElement.lang === 'es';
          const successMsg = isEs ? '¡¡CORREO COPIADO!' : 'COPIED TO CLIPBOARD';

          function showToast() {
            let toast = document.getElementById('ramia-toast');
            if (toast) toast.remove();
            
            toast = document.createElement('div');
            toast.id = 'ramia-toast';
            toast.className = 'fixed bottom-8 left-1/2 -translate-x-1/2 bg-neutral-900 text-white text-[11px] tracking-widest uppercase px-5 py-2.5 rounded-full shadow-2xl z-[9999] transition-all duration-300 opacity-0 translate-y-4';
            toast.textContent = successMsg;
            document.body.appendChild(toast);

            void toast.offsetWidth;
            toast.classList.remove('opacity-0', 'translate-y-4');
            toast.classList.add('opacity-100', 'translate-y-0');

            setTimeout(() => {
              toast.classList.remove('opacity-100', 'translate-y-0');
              toast.classList.add('opacity-0', 'translate-y-4');
              setTimeout(() => toast.remove(), 300);
            }, 2500);
          }

          function fallbackCopy() {
            try {
              const textArea = document.createElement('textarea');
              textArea.value = email;
              textArea.style.top = '0';
              textArea.style.left = '0';
              textArea.style.position = 'fixed';
              textArea.style.opacity = '0';
              document.body.appendChild(textArea);
              textArea.focus();
              textArea.select();
              const successful = document.execCommand('copy');
              document.body.removeChild(textArea);
              
              if (successful) {
                showToast();
              } else {
                window.location.href = rawHref;
              }
            } catch (err) {
              window.location.href = rawHref;
            }
          }

          if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(email)
              .then(showToast)
              .catch(fallbackCopy);
          } else {
            fallbackCopy();
          }
        }

        mailtoLinks.forEach((link) => {
          if (link.dataset.hasMailtoListener) return;
          link.dataset.hasMailtoListener = 'true';
          
          link.addEventListener('click', handleMailtoClick);
          link.addEventListener('touchend', (e) => {
            e.preventDefault();
            handleMailtoClick(e);
          }, { passive: false });
        });
      }

      // Soporte para carga inicial y navegaciÃ³n interna de Astro
      document.addEventListener('DOMContentLoaded', setupMailtoIntercept);
      document.addEventListener('astro:page-load', setupMailtoIntercept);
    </script>
  </body>
</html>

<style is:global>
  /* â”€â”€ Base reset â”€â”€ */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --font-display: 'Cormorant Garamond', Georgia, serif;
    --font-body:    'Plus Jakarta Sans', system-ui, sans-serif;
    --color-bg:     #FAF9F6;
    --color-ink:    #1a1a1a;
    --color-muted:  #9a9590;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-body);
    font-weight: 300;
    color: var(--color-ink);
    background-color: var(--color-bg);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100dvh;

    /* â”€â”€ Ambient light background â€” organic aurora on acrylic â”€â”€ */
    background-image:
      radial-gradient(ellipse 80% 50% at 20% 10%,  rgba(230,222,210,0.45) 0%, transparent 60%),
      radial-gradient(ellipse 60% 40% at 80% 5%,   rgba(210,218,230,0.30) 0%, transparent 55%),
      radial-gradient(ellipse 50% 35% at 50% 90%,  rgba(218,210,230,0.25) 0%, transparent 55%),
      radial-gradient(ellipse 70% 30% at 90% 60%,  rgba(235,230,220,0.20) 0%, transparent 60%),
      radial-gradient(ellipse 40% 60% at 5%  70%,  rgba(220,228,235,0.20) 0%, transparent 55%);
  }

  /* â”€â”€ Typography helpers â”€â”€ */
  .font-display { font-family: var(--font-display); }
  .font-body    { font-family: var(--font-body); }
</style>


